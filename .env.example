# Copy this file to .env and fill in real values for local development.
# In staging/production these are injected as real environment variables by
# the platform (Cloud Run, Docker, CI secrets) — no file is used there.
# See internal/pkg/config/config.go and docs/VARIABLES-ENTORNO.md.

# --- HTTP server -------------------------------------------------------
SERVER_PORT=8080
ENVIRONMENT=development
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:4200

# --- Postgres (internal/infrastructure/repositories/postgres) ----------
POSTGRESDB_USER=postgres
POSTGRESDB_PASS=postgres
POSTGRESDB_NAME=epa_standards_backend
POSTGRESDB_HOST=localhost
POSTGRESDB_PORT=5432

# --- Firestore (internal/infrastructure/repositories/firestore) --------
FIRESTORE_PROJECT_ID=my-gcp-project

# --- Auth middleware placeholder (internal/infrastructure/api/middlewares) --
# Leave empty locally to skip auth entirely. Replace the middleware with a
# real auth provider before using this in production.
API_AUTH_TOKEN=
